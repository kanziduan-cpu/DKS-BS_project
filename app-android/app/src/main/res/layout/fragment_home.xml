<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 妞ゅ爼鍎撮悩鑸碘偓浣圭埉 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/homeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_title_prefix"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"/>
                <TextView
                    android:id="@+id/homeWelcomeLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/homeTitle"
                    android:layout_marginTop="6dp"
                    android:maxLines="2"
                    android:text="@string/home_welcome_line"
                    android:textColor="#5B6670"
                    android:textSize="13sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignTop="@id/homeTitle"
                    android:background="#E6F4FF"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="MQTT / EMQX"
                    android:textColor="#096DD9"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </RelativeLayout>

            <!-- 1. 鏅鸿兘閫氶绯荤粺鍗＄墖 (SG90 + DHT11) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="窗户与温湿度"
                            android:textStyle="bold"
                            android:textSize="16sp"/>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/ventSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/ventTemp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="温度 --"
                            android:textColor="#FF4D4F"/>
                        <TextView
                            android:id="@+id/ventHumi"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="湿度 --"
                            android:textColor="#1890FF"/>
                        <TextView
                            android:id="@+id/ventStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="窗户状态待同步"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="水位监测"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <TextView
                            android:id="@+id/waterLevelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="水位 -- cm"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#096DD9"/>
                        <TextView
                            android:id="@+id/pumpStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="等待数据"
                            android:textColor="#52C41A"/>
                    </RelativeLayout>
                    <TextView
                        android:id="@+id/waterThresholdInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="阈值 -- cm"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                    <ProgressBar
                        android:id="@+id/waterProgress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:progress="12"
                        android:progressTint="#1890FF"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. 结构安全监测 (MPU6050) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/safetyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="安全监测"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:columnCount="2">
                        <TextView
                            android:id="@+id/tiltAngle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="倾角 -- 度"
                            android:textSize="14sp"/>
                        <TextView
                            android:id="@+id/vibrationIntensity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="振动 --"
                            android:layout_gravity="end"
                            android:textSize="14sp"/>
                    </GridLayout>
                    <TextView
                        android:id="@+id/safetyAlarmStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="等待安全状态"
                        android:textAlignment="center"
                        android:padding="4dp"
                        android:background="#F6FFED"
                        android:textColor="#52C41A"
                        android:textSize="13sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chartCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="环境趋势"
                            android:textStyle="bold"
                            android:textSize="16sp"/>
                        <Spinner
                            android:id="@+id/metricSelector"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="设备：STM32F103C8T6 + ESP8266-F12"
                        android:textColor="#8C8C8C"
                        android:textSize="12sp" />
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/lineChart"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
