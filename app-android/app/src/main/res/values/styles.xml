<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 全局 12px (24dp) 圆角卡片样式 -->
    <style name="IndustrialCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">#CCFFFFFF</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <!-- 线性图标容器样式 - 暖色调适配 -->
    <style name="LinearIconContainer">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/mi_avatar_background</item>
        <item name="android:backgroundTint">#FFF4E5</item>
    </style>

    <!-- 工业风按钮样式 -->
    <style name="IndustrialButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- 圆形头像样式 -->
    <style name="CircleAppearance">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 基础主题 -->
    <style name="Theme.WarehouseMonitor" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/mi_blue</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 无标题栏主题 (同步 AndroidManifest 引用) -->
    <style name="Theme.WarehouseMonitor.NoActionBar" parent="Theme.WarehouseMonitor">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- 启动页主题 -->
    <style name="Theme.WarehouseMonitor.Splash" parent="Theme.WarehouseMonitor.NoActionBar">
        <item name="android:windowBackground">@drawable/mi_sky_gradient</item>
    </style>

</resources>
